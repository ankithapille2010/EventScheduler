@model List<EventScheduler.Models.Event>

<h2>Employee List</h2>
<table>
    <tr>
        <th>ID</th>
        <th>Name</th>
    </tr>
    @foreach (var _event in Model)
    {
        <tr>
            <td>@_event.Title</td>
            <td>@_event.Date</td>
            <td>
                <a href="@Url.Action("Edit", "Event", new { id = _event.Id })" class="btn btn-warning btn-sm">Edit</a>
                <a href="@Url.Action("Delete", "Event", new { id = _event.Id })" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
</table>
<a href="@Url.Action("Create", "Event")" class="btn btn-secondary">Create New Event</a>